# NestJS ingest-engine
PORT=3030
NODE_ENV=development

# MySQL (use service name `mysql` inside Docker Compose)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tracesync
DB_USERNAME=tracesync
DB_PASSWORD=secret
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Redis (use service name `redis` inside Docker Compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AI enrichment - openai | anthropic | claude
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=
