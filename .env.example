# =============================================================================
# TraceSync AI - Docker Compose root environment
# Copy to .env and fill secrets before `docker compose up --build`
# =============================================================================

# MySQL
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=tracesync
MYSQL_USER=tracesync
MYSQL_PASSWORD=secret
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Host ports
LARAVEL_PORT=8080
NESTJS_PORT=3030
REACT_PORT=5173

# Laravel runtime (injected into the laravel service)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# NestJS runtime
NODE_ENV=development
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# AI (NestJS ingest enrichment)
# AI_PROVIDER: openai | anthropic | claude
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=

# Razorpay (Laravel Billing module)
# Prefer KEY / SECRET. KEY_ID / KEY_SECRET are accepted aliases.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12
RAZORPAY_CUSTOMER_NOTIFY=1

# Mail (Laravel)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="TraceSync AI"

# React (browser-facing URLs)
VITE_API_URL=http://localhost:8080
VITE_NESTJS_URL=http://localhost:3030
