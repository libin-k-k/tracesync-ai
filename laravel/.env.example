APP_NAME="TraceSync AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PHPUnit defaults to sqlite. For Docker Compose use mysql + redis hosts below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=tracesync
# DB_USERNAME=tracesync
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OneAuth (Sanctum)
ONEAUTH_DRIVER=sanctum
ONEAUTH_ROUTES_ENABLED=false
ONEAUTH_2FA_ENABLED=false
ONEAUTH_DETECT_SUSPICIOUS_LOGIN=false
PERMISSION_CACHE_DRIVER=array

# Razorpay (Billing module)
# Prefer KEY / SECRET. KEY_ID / KEY_SECRET are accepted aliases.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12
RAZORPAY_CUSTOMER_NOTIFY=1
